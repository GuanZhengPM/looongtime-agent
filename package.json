{
	"name": "looongtime-agent",
	"version": "0.1.0",
	"description": "Long-horizon coding agent harness with durable state and evidence-gated completion",
	"type": "module",
	"private": true,
	"bin": {
		"longtime": "src/cli.ts"
	},
	"scripts": {
