		"test": "bun test"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.84.2",
		"@earendil-works/pi-tui": "0.84.2"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"typescript": "5.9.3"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
